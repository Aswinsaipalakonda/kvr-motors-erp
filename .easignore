# Exclude everything except mobile-app source files
# EAS Build only needs the mobile-app directory

# Exclude backend and dashboards entirely
backend/
dashboards/

# Exclude git and IDE files
.git/
.agents/
.kiro/
.vscode/
.claude/

# Exclude large archive files
*.tar.gz
*.zip
*.png

# Exclude documentation
*.md
prompts.md
roadmap.md

# Exclude mobile-app build artifacts and caches
node_modules/
.expo/
dist/
web-build/
tsc_errors.log
tsc_errors_utf8.txt

# Exclude skills-lock
skills-lock.json
